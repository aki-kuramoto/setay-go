# Grammar definition for the setay format.
# setay is a format designed primarily for saving and loading
# structured data in text form.
package setayparser;

root-def SetayDocument
{
	_: SetaySpacing;
	dict: SetayDict;
	_trailingSemi: zero-or-one<SetayTrailingSemicolon>;
	_: SetaySpacing;
};

# ======================================================================
#  Values
# ======================================================================

def SetayValue
{
	_: SetayVarRef
	   or SetaySet or SetayDict or SetayList
	   or SetayUtcTs
	   or SetayTrue or SetayFalse or SetayNull
	   or SetayNumber
	   or SetayString;
};

# --- Null / Boolean ---

def SetayNull  { _: "null"; };
def SetayTrue  { _: "true"; };
def SetayFalse { _: "false"; };

# ======================================================================
#  Set { key=; ... }
# ======================================================================

# A set is written as a dict-like block where every entry has no value,
# using the atomic token "=;" as the entry terminator.
# The empty set is written as {=;} (not {} which is the empty dict).
# Spaces are allowed between the key and "=;", but not inside "=;" itself.
# Go mapping: map[ELEMENT_TYPE]struct{}
def SetaySet
{
	_: '{';
	_: SetaySpacing;
	body: SetaySetBody;
	_: SetaySpacing;
	_: '}';
};

def SetaySetBody
{
	_: SetaySetEmpty or SetaySetEntries;
};

# Empty set body: just the "=;" token (surrounding spacing handled by SetaySet).
def SetaySetEmpty
{
	_: "=;";
};

# Non-empty set: one or more entries (each self-terminating with "=;").
def SetaySetEntries
{
	first: SetaySetEntry;
	rest: zero-or-more<SetaySetEntry>;
};

# A single set entry: key  =;
# Spacing before "=;" is allowed; "=;" itself is atomic (no internal space).
def SetaySetEntry
{
	_: SetaySpacing;
	key: SetaySetKey;
	_: SetaySpacing;
	_: "=;";
};

# Set keys are restricted to scalar (comparable) values.
# Dict, List, and nested Set are excluded because they are not comparable
# and cannot serve as Go map keys.
def SetaySetKey
{
	_: SetayVarRef
	   or SetayUtcTs
	   or SetayTrue or SetayFalse or SetayNull
	   or SetayNumber
	   or SetayString;
};

# ======================================================================
#  Dict { ... }
# ======================================================================

def SetayDict
{
	_: '{';
	_: SetaySpacing;
	entries: zero-or-one<SetayDictEntries>;
	_: SetaySpacing;
	_: '}';
};

# Dict entries.
# After the first entry, the pattern repeats as: semicolon + next entry.
# The trailing semicolon is optional.
def SetayDictEntries
{
	first: SetayDictEntry;
	rest: zero-or-more<SetayDictEntrySep>;
	_trailingSemi: zero-or-one<SetayTrailingSemicolon>;
	_: SetaySpacing;
};

def SetayDictEntrySep
{
	_: SetaySpacing;
	_: ';';
	_: SetaySpacing;
	entry: SetayDictEntry;
};

def SetayTrailingSemicolon
{
	_: SetaySpacing;
	_: ';';
};

# A single dict entry: "key = value", or a flag entry "key" (the "= value"
# omitted). A flag entry denotes the boolean value true (present = true); it is
# meant for DSL-like configs, e.g. { verbose; retries = 3; }. A flag entry and
# "key = true" are two spellings of the same value; the formatter preserves the
# author's choice in BOTH directions (it never expands "key" to "key = true"
# and never folds "key = true" to "key").
def SetayDictEntry
{
	key: SetayDictKey;
	assign: zero-or-one<SetayDictEntryAssign>;
};

# The "= value" part of a dict entry. When it is absent the entry is a flag
# entry (implicit true). Spacing around '=' is allowed.
def SetayDictEntryAssign
{
	_: SetaySpacing;
	_: '=';
	_: SetaySpacing;
	value: SetayValue;
};

# Dict key: unquoted key or string.
def SetayDictKey
{
	_: SetayUnquotedKey or SetayString;
};

# ======================================================================
#  Unquoted Key
# ======================================================================

# An unquoted key is a plain identifier used as a dict key without quotes (as
# opposed to a quoted string key). First char: [a-zA-Z_], middle: [a-zA-Z0-9_-],
# last: [a-zA-Z0-9_] (no hyphen). A single-character key consists of just the
# first character.
def SetayUnquotedKey
{
	firstCh: SetayUnquotedKeyLeadChar;
	trailing: zero-or-one<SetayUnquotedKeyTrailingPart>;
};

def SetayUnquotedKeyTrailingPart
{
	midChars: zero-or-more<SetayUnquotedKeyContinueChar>;
	lastCh: SetayUnquotedKeyTrailingChar;
};

# Characters allowed at the start: [a-zA-Z_]
def SetayUnquotedKeyLeadChar
{
	_: char-range<'a','z'> or char-range<'A','Z'> or '_';
};

# Characters allowed in the middle: [a-zA-Z0-9_-]
def SetayUnquotedKeyContinueChar
{
	_: char-range<'a','z'> or char-range<'A','Z'> or char-range<'0','9'> or '_' or '-';
};

# Characters allowed at the end: [a-zA-Z0-9_] (no hyphen)
def SetayUnquotedKeyTrailingChar
{
	_: char-range<'a','z'> or char-range<'A','Z'> or char-range<'0','9'> or '_';
};

# ======================================================================
#  List [ ... ]
# ======================================================================

def SetayList
{
	_: '[';
	_: SetaySpacing;
	elements: zero-or-one<SetayListElements>;
	_: SetaySpacing;
	_: ']';
};

# List elements.
# After the first element, the pattern repeats as: comma + next element.
# The trailing comma is optional.
def SetayListElements
{
	first: SetayValue;
	rest: zero-or-more<SetayListElemSep>;
	_trailingComma: zero-or-one<SetayTrailingComma>;
	_: SetaySpacing;
};

def SetayListElemSep
{
	_: SetaySpacing;
	_: ',';
	_: SetaySpacing;
	value: SetayValue;
};

def SetayTrailingComma
{
	_: SetaySpacing;
	_: ',';
};

# ======================================================================
#  Strings
# ======================================================================

def SetayString
{
	_: SetayDqString or SetaySqString;
};

# --- Double-quoted string "..." ---

def SetayDqString
{
	_: '"';
	content: zero-or-more<SetayDqStringContent>;
	_: '"';
};

def SetayDqStringContent
{
	_: SetayVarRef or SetayEscapeSequence or SetayDqNormalChar;
};

# Any character except '"', '\', '$', '{', '}'.
# '$' '{' '}' are excluded so that '${' parses as SetayVarRef and so that a
# literal '$', '{', or '}' must be written as an escape (\$ \{ \}).
def SetayDqNormalChar
{
	_: anychar-except<'"' or '\\' or '$' or '{' or '}'>;
};

# --- Single-quoted string '...' ---

def SetaySqString
{
	_: '\'';
	content: zero-or-more<SetaySqStringContent>;
	_: '\'';
};

def SetaySqStringContent
{
	_: SetayEscapeSequence or SetaySqNormalChar;
};

# Any character except '\'' and '\'.
def SetaySqNormalChar
{
	_: anychar-except<'\'' or '\\'>;
};

# ======================================================================
#  Escape Sequences
# ======================================================================

def SetayEscapeSequence
{
	_: '\\';
	ch: SetayEscapeChar;
};

def SetayEscapeChar
{
	_: 'n' or 'r' or 't' or '0'
	   or SetayHexEscape or SetayUnicode4Escape or SetayUnicode8Escape
	   or SetayAsciiSymbol;
};

# Any printable ASCII symbol (punctuation): '\' + symbol yields the literal
# symbol. Covers " ' \ $ { } and every other ASCII punctuation. Space is
# intentionally excluded (a '\' + space is invalid).
def SetayAsciiSymbol
{
	_: char-range<'!','/'> or char-range<':','@'>
	   or char-range<'[','`'> or char-range<'{','~'>;
};

# \xXX -- the first hex digit is restricted to 0-7, limiting the value to
# 0x00-0x7F.
def SetayHexEscape
{
	_: 'x';
	_: SetayHexDigit07;
	_: SetayHexDigit;
};

def SetayHexDigit07
{
	_: char-range<'0','7'>;
};

# \uXXXX
def SetayUnicode4Escape
{
	_: 'u';
	_: SetayHexDigit;
	_: SetayHexDigit;
	_: SetayHexDigit;
	_: SetayHexDigit;
};

# \UXXXXXXXX
def SetayUnicode8Escape
{
	_: 'U';
	_: SetayHexDigit;
	_: SetayHexDigit;
	_: SetayHexDigit;
	_: SetayHexDigit;
	_: SetayHexDigit;
	_: SetayHexDigit;
	_: SetayHexDigit;
	_: SetayHexDigit;
};

def SetayHexDigit
{
	_: char-range<'0','9'> or char-range<'a','f'> or char-range<'A','F'>;
};

# ======================================================================
#  Numbers
# ======================================================================

# Numbers are tried in order: prefixed integer, float, decimal integer.
# Floats contain '.' or 'e'/'E'.
# Trying float before decimal integer ensures "4.11" is parsed correctly.
def SetayNumber
{
	_: SetayPrefixedInt or SetayFloat or SetayDecInt;
};

# --- Decimal integer ---
# Leading zeros are interpreted as decimal, not octal.
def SetayDecInt
{
	sign: zero-or-one<'-'>;
	digits: SetayDecDigit;
	rest: zero-or-more<SetayDecDigit>;
};

def SetayDecDigit
{
	_: char-range<'0','9'>;
};

# --- Floating-point number ---
def SetayFloat
{
	sign: zero-or-one<'-'>;
	intPart: SetayDecDigit;
	intRest: zero-or-more<SetayDecDigit>;
	part: SetayFloatFrac or SetayFloatExp;
};

def SetayFloatFrac
{
	_: '.';
	firstDigit: SetayDecDigit;
	rest: zero-or-more<SetayDecDigit>;
	exp: zero-or-one<SetayFloatExp>;
};

def SetayFloatExp
{
	_: 'e' or 'E';
	sign: zero-or-one<'+' or '-'>;
	firstDigit: SetayDecDigit;
	rest: zero-or-more<SetayDecDigit>;
};

# --- Prefixed integers ---
def SetayPrefixedInt
{
	_: SetayHexInt or SetayBinInt or SetayOctInt or SetayDecPrefixedInt;
};

# 0x / 0X: hexadecimal
def SetayHexInt
{
	sign: zero-or-one<'-'>;
	_: "0x" or "0X";
	first: SetayHexDigit;
	rest: zero-or-more<SetayHexDigit>;
};

# 0b / 0B: binary
def SetayBinInt
{
	sign: zero-or-one<'-'>;
	_: "0b" or "0B";
	first: '0' or '1';
	rest: zero-or-more<SetayBinDigit>;
};

def SetayBinDigit
{
	_: '0' or '1';
};

# 0o / 0O: octal
def SetayOctInt
{
	sign: zero-or-one<'-'>;
	_: "0o" or "0O";
	first: char-range<'0','7'>;
	rest: zero-or-more<SetayOctDigit>;
};

def SetayOctDigit
{
	_: char-range<'0','7'>;
};

# 0d / 0D: explicit decimal notation
def SetayDecPrefixedInt
{
	sign: zero-or-one<'-'>;
	_: "0d" or "0D";
	first: SetayDecDigit;
	rest: zero-or-more<SetayDecDigit>;
};

# ======================================================================
#  UTC Timestamp
# ======================================================================

def SetayUtcTs
{
	_: "UtcTs";
	_: '(';
	_: SetaySpacing;
	value: SetayString;
	_: SetaySpacing;
	_: ')';
};

# ======================================================================
#  Comments
# ======================================================================

# setay supports the following comment types:
#   1. "# " (hash + space): single-line comment
#   2. "#\t" (hash + tab): single-line comment
#   3. "##" (double hash): single-line comment
#   4. "#!" (hash + exclamation): reserved expression (intended for shebang),
#      ignored until end of line. While it behaves like a comment, it should
#      not be used as a general-purpose comment.
#   5. "#{" ~ "}#": multi-line comment (non-nesting)
#   6. "#" immediately followed by a newline (CR, LF, or CRLF) or by
#      end-of-input: an empty single-line comment.
def SetayComment
{
	_: SetayMultiLineComment
	   or SetayLineCommentHash
	   or SetayLineCommentSpace
	   or SetayLineCommentTab
	   or SetayLineCommentShebang
	   or SetayLineCommentEmpty;
};

# "# " (hash + space) single-line comment
def SetayLineCommentSpace
{
	_: "# ";
	_: zero-or-more<SetayLineCommentChar>;
};

# "#\t" (hash + tab) single-line comment
def SetayLineCommentTab
{
	_: "#\t";
	_: zero-or-more<SetayLineCommentChar>;
};

# "##" (double hash) single-line comment
def SetayLineCommentHash
{
	_: "##";
	_: zero-or-more<SetayLineCommentChar>;
};

# "#!" (hash + exclamation) reserved expression (shebang, etc.)
def SetayLineCommentShebang
{
	_: "#!";
	_: zero-or-more<SetayLineCommentChar>;
};

# "#" immediately followed by a newline or end-of-input: an empty comment.
# It consumes only the "#"; the following newline (if any) is handled by
# SetaySpacingItem. The not-followed-by<SetayLineCommentChar> guard means the
# next character must be a newline or absent (end-of-input); a "#" followed by
# any other character (e.g. "#foo") is still a parse error.
def SetayLineCommentEmpty
{
	_: '#';
	_: not-followed-by<SetayLineCommentChar>;
};

# Single-line comment body character (everything except newline)
def SetayLineCommentChar
{
	_: anychar-except<'\n' or '\r'>;
};

# "#{" ~ "}#" multi-line comment (non-nesting)
def SetayMultiLineComment
{
	_: "#{";
	content: zero-or-more<SetayMultiLineCommentContent>;
	_: "}#";
};

# Characters inside a multi-line comment.
# To prevent premature closing, '}' is only allowed when not followed by '#'.
def SetayMultiLineCommentContent
{
	_: SetayMultiLineCommentBrace or SetayMultiLineCommentNormalChar;
};

# '}' alone (only when not followed by '#')
def SetayMultiLineCommentBrace
{
	_: '}';
	_: not-followed-by<'#'>;
};

# Any character except '}'
def SetayMultiLineCommentNormalChar
{
	_: anychar-except<'}'>;
};

# ======================================================================
#  Variable Reference  ${VAR_NAME ?: fallback}
# ======================================================================

# Top-level variable reference: ${ expr }
def SetayVarRef
{
	_: "${";
	_: SetaySpacing;
	expr: SetayVarExpr;
	_: SetaySpacing;
	_: '}';
};

# Variable expression: a variable name with an optional fallback chain.
def SetayVarExpr
{
	varName: SetayVarName;
	fallback: zero-or-one<SetayVarFallback>;
};

# Variable name: same rules as an unquoted key.
# (Backtick syntax is NOT supported; use string interpolation instead.)
def SetayVarName
{
	firstCh: SetayUnquotedKeyLeadChar;
	trailing: zero-or-one<SetayUnquotedKeyTrailingPart>;
};

# Fallback chain: ?: value  (can nest recursively for chaining)
def SetayVarFallback
{
	_: SetaySpacing;
	_: "?:";
	_: SetaySpacing;
	value: SetayVarOrValue;
	next: zero-or-one<SetayVarFallback>;
};

# A fallback value: another variable reference, a boolean literal, a bare
# variable name, or a literal value (number or string).
# SetayTrue/SetayFalse must come BEFORE SetayVarName so that the words "true"
# and "false" resolve to booleans instead of being read as variable names.
# SetayVarName must come BEFORE SetayNumber/SetayString to avoid ambiguity.
def SetayVarOrValue
{
	_: SetayVarRef or SetayTrue or SetayFalse or SetayVarName or SetayNumber or SetayString;
};

# ======================================================================
#  Whitespace / Newlines
# ======================================================================

# setay spacing: skips spaces, tabs, newlines, BOM, and comments.
def SetaySpacing
{
	_: zero-or-more<SetaySpacingItem>;
};

def SetaySpacingItem
{
	_: ' ' or '\t' or "\r\n" or '\n' or '\r' or '\uFEFF' or SetayComment;
};
