# Grammar for setay value-addressing paths. See docs/setay-path-notation.ja.md.
# A path is ":/" (the root marker, one atomic token) followed by "."-separated
# segments. Each segment selects a dict key or a list index:
#   - an unquoted key (LenientIdentifier: [A-Za-z_] then [A-Za-z0-9_-]*, no
#     leading or trailing hyphen),
#   - a quoted key (a setay string, DQ or SQ, that does NOT interpolate; DQ
#     reserves $ { }, SQ needs only ' and \ escaped), or
#   - a numeric list index, optionally negative.
# Examples: :/name  :/server.host  :/servers.0  :/ports.-1  :/"a.b"  :/'a${b}'
# No brackets, no streaming, no pipes -- those belong to setayq.
package setaypath;

root-def SetayPath
{
	_: ":/";
	first: SetayPathSegment;
	rest: zero-or-more<SetayPathSegmentSep>;
};

def SetayPathSegmentSep
{
	_: '.';
	segment: SetayPathSegment;
};

def SetayPathSegment
{
	_: SetayPathIndex or SetayPathUnquotedKey or SetayPathQuotedKey;
};

# --- Numeric list index (optionally negative) ---

def SetayPathIndex
{
	sign: zero-or-one<SetayPathMinus>;
	digits: one-or-more<SetayPathDigit>;
};

def SetayPathMinus
{
	_: '-';
};

def SetayPathDigit
{
	_: char-range<'0','9'>;
};

# --- Unquoted key = LenientIdentifier ---

def SetayPathUnquotedKey
{
	firstCh: SetayPathKeyLead;
	trailing: zero-or-one<SetayPathKeyTrailing>;
};

def SetayPathKeyTrailing
{
	midChars: zero-or-more<SetayPathKeyMid>;
	lastCh: SetayPathKeyLast;
};

def SetayPathKeyLead
{
	_: char-range<'a','z'> or char-range<'A','Z'> or '_';
};

def SetayPathKeyMid
{
	_: char-range<'a','z'> or char-range<'A','Z'> or char-range<'0','9'> or '_' or '-';
};

def SetayPathKeyLast
{
	_: char-range<'a','z'> or char-range<'A','Z'> or char-range<'0','9'> or '_';
};

# --- Quoted key (a setay string used as a key; no interpolation) ---

def SetayPathQuotedKey
{
	_: SetayPathDqKey or SetayPathSqKey;
};

# Double-quoted: reserves $ { } (must be escaped), like a setay DQ string but
# without interpolation.
def SetayPathDqKey
{
	_: '"';
	content: zero-or-more<SetayPathDqContent>;
	_: '"';
};

def SetayPathDqContent
{
	_: SetayPathEscape or SetayPathDqNormal;
};

def SetayPathDqNormal
{
	_: anychar-except<'"' or '\\' or '$' or '{' or '}'>;
};

# Single-quoted: minimal required escaping (only ' and \).
def SetayPathSqKey
{
	_: '\'';
	content: zero-or-more<SetayPathSqContent>;
	_: '\'';
};

def SetayPathSqContent
{
	_: SetayPathEscape or SetayPathSqNormal;
};

def SetayPathSqNormal
{
	_: anychar-except<'\'' or '\\'>;
};

# --- Escape sequences (same set as setay strings) ---

def SetayPathEscape
{
	_: '\\';
	ch: SetayPathEscapeChar;
};

def SetayPathEscapeChar
{
	_: 'n' or 'r' or 't' or '0'
	   or SetayPathHexEscape or SetayPathUnicode4 or SetayPathUnicode8
	   or SetayPathAsciiSymbol;
};

def SetayPathAsciiSymbol
{
	_: char-range<'!','/'> or char-range<':','@'>
	   or char-range<'[','`'> or char-range<'{','~'>;
};

def SetayPathHexEscape
{
	_: 'x';
	_: SetayPathHex07;
	_: SetayPathHexDigit;
};

def SetayPathHex07
{
	_: char-range<'0','7'>;
};

def SetayPathUnicode4
{
	_: 'u';
	_: SetayPathHexDigit;
	_: SetayPathHexDigit;
	_: SetayPathHexDigit;
	_: SetayPathHexDigit;
};

def SetayPathUnicode8
{
	_: 'U';
	_: SetayPathHexDigit;
	_: SetayPathHexDigit;
	_: SetayPathHexDigit;
	_: SetayPathHexDigit;
	_: SetayPathHexDigit;
	_: SetayPathHexDigit;
	_: SetayPathHexDigit;
	_: SetayPathHexDigit;
};

def SetayPathHexDigit
{
	_: char-range<'0','9'> or char-range<'a','f'> or char-range<'A','F'>;
};
